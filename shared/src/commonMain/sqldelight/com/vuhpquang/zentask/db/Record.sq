-- Every synced record, whatever its entity: fields and per-field HLC clocks as JSON objects.
-- Generic on purpose (P1 plan, "Generic record storage"): a newer client's fields and entities survive here.
CREATE TABLE record (
    entity TEXT NOT NULL,
    id TEXT NOT NULL,
    fields TEXT NOT NULL,
    clocks TEXT NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (entity, id)
);

CREATE INDEX record_entity_deleted ON record(entity, deleted);

upsert:
INSERT OR REPLACE INTO record(entity, id, fields, clocks, deleted) VALUES (?, ?, ?, ?, ?);

byId:
SELECT * FROM record WHERE entity = ? AND id = ?;

live:
SELECT * FROM record WHERE entity = ? AND deleted = 0;

-- Live records whose JSON start..end range overlaps [from, until] (calendar events in a window).
liveOverlapping:
SELECT * FROM record WHERE entity = ? AND deleted = 0
  AND CAST(json_extract(fields, '$.start') AS INTEGER) <= :until
  AND MAX(COALESCE(CAST(json_extract(fields, '$.end') AS INTEGER), 0), CAST(json_extract(fields, '$.start') AS INTEGER)) >= :from;

-- Live ids of an entity whose JSON field (path like '$.parentId') equals a value.
idsByField:
SELECT id FROM record WHERE entity = ? AND deleted = 0 AND json_extract(fields, ?) = ?;
